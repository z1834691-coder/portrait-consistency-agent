# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# Sensitive, generated, or temporary photo data
storage/*
!storage/.gitkeep
logs/*
!logs/.gitkeep
data/local/
*.sqlite
*.sqlite3
*.db

# Uploaded / generated images
*.jpg
*.jpeg
*.png
*.webp

# Private evaluation artifacts and local workspace metadata. The deployable
# app only needs reviewed Provider Cards; hidden/holdout questions, generated
# reports and answer keys stay outside the GitHub deployment repository.
.obsidian/
reports/*
# The E3 dashboard needs only these redacted evidence artifacts at deploy time;
# they contain hashes/metadata, never image bytes, data URLs, paths or secrets.
!reports/effect_web_e3_preflight_v1.json
!reports/effect_web_e3_preflight_v1.html
!reports/effect_web_e3_live_manifest_v1.json
!reports/effect_web_e3_evidence_v1.json
!reports/effect_web_e3_evidence_v1.html
data/evaluation/*
!data/evaluation/rag_safety_event_catalog_v0.json
!data/evaluation/rag_gold_v2_public.json
!data/evaluation/rag_gold_v2_annotations.json
!data/evaluation/rag_gold_v3_holdout_runtime.template.json

# OS / editor
.DS_Store
.idea/
.vscode/
