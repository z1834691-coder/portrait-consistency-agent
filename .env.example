# Local runtime only. Copy this file to .env; do not commit .env.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8501
APP_LOG_LEVEL=INFO
DATABASE_PATH=storage/demo.sqlite3
KNOWLEDGE_DATABASE_PATH=storage/knowledge.sqlite3
# RAG P0-B keeps vector data and local model weights outside the user-operation ledger.
# Model download is disabled at runtime by default. Provision it explicitly with the smoke command.
RAG_VECTOR_DATABASE_PATH=storage/knowledge_vectors.sqlite3
RAG_MODEL_CACHE_PATH=storage/model_cache
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
RAG_ALLOW_MODEL_DOWNLOAD=false
TRACE_PATH=logs/events.jsonl
PHOTO_TTL_HOURS=24

# Tencent Cloud credentials are intentionally blank.
# Add them only to your local .env after you decide the account, budget, and region.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_BEAUTIFY_ENDPOINT=fmu.tencentcloudapi.com
TENCENT_SUBJECT_ENDPOINT=iai.tencentcloudapi.com
TENCENT_MODERATION_ENDPOINT=ims.tencentcloudapi.com
# Optional: a configured Image Moderation BizType; blank uses Tencent's default policy.
TENCENT_MODERATION_BIZ_TYPE=

# Checkpoint 7: DeepSeek is the frozen primary LLM for structured intent parsing.
# A remote call also requires explicit per-turn text consent; otherwise the app uses
# the local template fallback. Never send images, Base64, face vectors, or secrets.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=900
LLM_DATA_POLICY_VERSION=llm-text-only-v0

# Candidate Provider shells only: these are presence probes, not verified API schemas.
# Leave blank until the vendor has supplied official auth/region/privacy/price evidence.
VOLC_BEAUTY_CREDENTIAL_REF=
